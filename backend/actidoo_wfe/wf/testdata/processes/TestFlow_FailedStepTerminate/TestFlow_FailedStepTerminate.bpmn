    <bpmn:sequenceFlow id="Flow_start_to_split" sourceRef="StartEvent" targetRef="Split" />
    <bpmn:sequenceFlow id="Flow_split_to_failing" sourceRef="Split" targetRef="FailingStep" />
    <bpmn:sequenceFlow id="Flow_failing_to_end" sourceRef="FailingStep" targetRef="EndEvent" />
    <bpmn:sequenceFlow id="Flow_split_to_terminate" sourceRef="Split" targetRef="TerminateEndEvent" />
