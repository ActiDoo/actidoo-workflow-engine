<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_fs" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_fs">
    <bpmn:participant id="Participant_fs" name="Form semantics" processRef="TestFlow_FormSemantics" />
  </bpmn:collaboration>
  <bpmn:process id="TestFlow_FormSemantics" name="Form semantics" isExecutable="true">
    <bpmn:laneSet id="LaneSet_fs">
      <bpmn:lane id="InitLane" name="Init Lane">
        <bpmn:extensionElements>
          <zeebe:properties>
            <zeebe:property name="initiator" value="true" />
          </zeebe:properties>
        </bpmn:extensionElements>
        <bpmn:flowNodeRef>StartEvent_fs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PrepareCases</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Form010_Cases</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RecordReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_again</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_fs</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_fs">
      <bpmn:outgoing>Flow_start_seed</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="PrepareCases" name="Prepare test cases">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="prepare_cases" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_start_seed</bpmn:incoming>
      <bpmn:outgoing>Flow_seed_cases</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Form010_Cases" name="Fill, change or clear">
      <bpmn:incoming>Flow_seed_cases</bpmn:incoming>
      <bpmn:incoming>Flow_again</bpmn:incoming>
      <bpmn:outgoing>Flow_cases_record</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="RecordReceived" name="Record what arrived">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="record_received" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_cases_record</bpmn:incoming>
      <bpmn:outgoing>Flow_record_gateway</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_again" name="Again?" default="Flow_done">
      <bpmn:incoming>Flow_record_gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_again</bpmn:outgoing>
      <bpmn:outgoing>Flow_done</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_fs">
      <bpmn:incoming>Flow_done</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_start_seed" sourceRef="StartEvent_fs" targetRef="PrepareCases" />
    <bpmn:sequenceFlow id="Flow_seed_cases" sourceRef="PrepareCases" targetRef="Form010_Cases" />
    <bpmn:sequenceFlow id="Flow_cases_record" sourceRef="Form010_Cases" targetRef="RecordReceived" />
    <bpmn:sequenceFlow id="Flow_record_gateway" sourceRef="RecordReceived" targetRef="Gateway_again" />
    <bpmn:sequenceFlow id="Flow_again" name="yes" sourceRef="Gateway_again" targetRef="Form010_Cases">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=again = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_done" name="no" sourceRef="Gateway_again" targetRef="EndEvent_fs" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_fs">
    <bpmndi:BPMNPlane id="BPMNPlane_fs" bpmnElement="Collaboration_fs">
      <bpmndi:BPMNShape id="Participant_fs_di" bpmnElement="Participant_fs" isHorizontal="true">
        <dc:Bounds x="100" y="60" width="860" height="260" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="InitLane_di" bpmnElement="InitLane" isHorizontal="true">
        <dc:Bounds x="130" y="60" width="830" height="260" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_fs_di" bpmnElement="StartEvent_fs">
        <dc:Bounds x="180" y="202" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PrepareCases_di" bpmnElement="PrepareCases">
        <dc:Bounds x="260" y="180" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Form010_Cases_di" bpmnElement="Form010_Cases">
        <dc:Bounds x="410" y="180" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="RecordReceived_di" bpmnElement="RecordReceived">
        <dc:Bounds x="560" y="180" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_again_di" bpmnElement="Gateway_again" isMarkerVisible="true">
        <dc:Bounds x="715" y="195" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="723" y="252" width="35" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_fs_di" bpmnElement="EndEvent_fs">
        <dc:Bounds x="832" y="202" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_start_seed_di" bpmnElement="Flow_start_seed">
        <di:waypoint x="216" y="220" />
        <di:waypoint x="260" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_seed_cases_di" bpmnElement="Flow_seed_cases">
        <di:waypoint x="360" y="220" />
        <di:waypoint x="410" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_cases_record_di" bpmnElement="Flow_cases_record">
        <di:waypoint x="510" y="220" />
        <di:waypoint x="560" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_record_gateway_di" bpmnElement="Flow_record_gateway">
        <di:waypoint x="660" y="220" />
        <di:waypoint x="715" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_again_di" bpmnElement="Flow_again">
        <di:waypoint x="740" y="195" />
        <di:waypoint x="740" y="110" />
        <di:waypoint x="460" y="110" />
        <di:waypoint x="460" y="180" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="592" y="92" width="17" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_done_di" bpmnElement="Flow_done">
        <di:waypoint x="765" y="220" />
        <di:waypoint x="832" y="220" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="792" y="202" width="13" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
