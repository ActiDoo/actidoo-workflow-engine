<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_do" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_do">
    <bpmn:participant id="Participant_do" name="Depends On" processRef="TestFlow_DependsOn" />
  </bpmn:collaboration>
  <bpmn:process id="TestFlow_DependsOn" name="Depends On" isExecutable="true">
    <bpmn:laneSet id="LaneSet_do">
      <bpmn:lane id="InitLane" name="Init Lane">
        <bpmn:extensionElements>
          <zeebe:properties>
            <zeebe:property name="initiator" value="true" />
          </zeebe:properties>
        </bpmn:extensionElements>
        <bpmn:flowNodeRef>StartEvent_do</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Form010_Fill</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_do</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_do">
      <bpmn:outgoing>Flow_start_fill</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Form010_Fill" name="Fill form">
      <bpmn:incoming>Flow_start_fill</bpmn:incoming>
      <bpmn:outgoing>Flow_fill_end</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_do">
      <bpmn:incoming>Flow_fill_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_start_fill" sourceRef="StartEvent_do" targetRef="Form010_Fill" />
    <bpmn:sequenceFlow id="Flow_fill_end" sourceRef="Form010_Fill" targetRef="EndEvent_do" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_do">
      <bpmndi:BPMNShape id="Participant_do_di" bpmnElement="Participant_do" isHorizontal="true">
        <dc:Bounds x="100" y="60" width="500" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="InitLane_di" bpmnElement="InitLane" isHorizontal="true">
        <dc:Bounds x="130" y="60" width="470" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_do_di" bpmnElement="StartEvent_do">
        <dc:Bounds x="180" y="140" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Form010_Fill_di" bpmnElement="Form010_Fill">
        <dc:Bounds x="280" y="118" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_do_di" bpmnElement="EndEvent_do">
        <dc:Bounds x="440" y="140" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_start_fill_di" bpmnElement="Flow_start_fill">
        <di:waypoint x="216" y="158" />
        <di:waypoint x="280" y="158" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_fill_end_di" bpmnElement="Flow_fill_end">
        <di:waypoint x="380" y="158" />
        <di:waypoint x="440" y="158" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
