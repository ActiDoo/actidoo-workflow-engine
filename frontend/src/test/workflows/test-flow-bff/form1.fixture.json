{
  "jsonschema": {
    "definitions": {},
    "type": "object",
    "properties": {
      "required_text": {
        "type": "string",
        "title": "Required text",
        "minLength": 2
      },
      "short_code": {
        "type": "string",
        "title": "Short code",
        "maxLength": 3,
        "custom_properties": {
          "template_field": "false"
        }
      },
      "category": {
        "type": [
          "string",
          "null"
        ],
        "title": "Category",
        "custom_properties": {
          "options_file": "categories.csv"
        }
      },
      "attachment": {
        "type": "object",
        "title": "Attachment",
        "properties": {
          "datauri": {
            "type": "string",
            "format": "data-url"
          },
          "filename": {
            "type": "string"
          },
          "hash": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "mimetype": {
            "type": "string"
          }
        }
      },
      "optional_note": {
        "type": "string",
        "title": "Optional note"
      },
      "cost_center": {
        "type": "string",
        "title": "Cost center",
        "pattern": "^CC-[0-9]{4}$",
        "custom_properties": {
          "pattern_message": "Cost center like CC-1234"
        }
      },
      "trigger_error": {
        "type": "boolean",
        "title": "Trigger error"
      }
    },
    "required": [
      "required_text"
    ]
  },
  "uischema": {
    "ui:field": "layout",
    "ui:layout": {
      "Row_1": [
        "required_text"
      ],
      "Row_1b": [
        "short_code"
      ],
      "Row_2": [
        "category"
      ],
      "Row_3": [
        "attachment"
      ],
      "Row_4": [
        "optional_note"
      ],
      "Row_4b": [
        "cost_center"
      ],
      "Row_5": [
        "trigger_error"
      ]
    },
    "required_text": {
      "ui:description": "",
      "ui:enableMarkdownInDescription": true,
      "ui:path": [
        "required_text"
      ]
    },
    "short_code": {
      "ui:description": "",
      "ui:enableMarkdownInDescription": true,
      "ui:path": [
        "short_code"
      ]
    },
    "category": {
      "ui:description": "",
      "ui:enableMarkdownInDescription": true,
      "ui:path": [
        "category"
      ],
      "ui:widget": "SelectDynamic"
    },
    "attachment": {
      "ui:description": "",
      "ui:path": [
        "attachment"
      ],
      "ui:field": "AttachmentSingle"
    },
    "optional_note": {
      "ui:description": "",
      "ui:enableMarkdownInDescription": true,
      "ui:path": [
        "optional_note"
      ]
    },
    "cost_center": {
      "ui:description": "",
      "ui:enableMarkdownInDescription": true,
      "ui:path": [
        "cost_center"
      ],
      "ui:patternMessage": "Cost center like CC-1234"
    },
    "trigger_error": {
      "ui:description": "",
      "ui:enableMarkdownInDescription": true,
      "ui:path": [
        "trigger_error"
      ]
    },
    "ui:templateMode": "blacklist"
  }
}
